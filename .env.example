# Copy to .env.local and fill in what you have. Only the first block is
# required; every other integration switches on when its keys are present.

# --- DigitalOcean Serverless Inference: Gemma 4 (required) ---------------
# Control panel > Inference > Serverless inference > Model access keys
DO_MODEL_ACCESS_KEY=
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
PANGA_MODEL=gemma-4-31B-it
# Optional: an embedding model ID from GET /v1/models, for meaning-based
# past-project search (keyword search works without it).
PANGA_EMBEDDING_MODEL=

# --- DigitalOcean Spaces: keeps original PDFs and voice notes --------------
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=blr1

# --- Tiger Data (Postgres + pgvector) ---------------------------------------
# Without it Panga uses an embedded PGlite database in .data/ (fine locally).
DATABASE_URL=

# --- Temporal: durable deal workflows ---------------------------------------
# Needs DATABASE_URL too. Local: `temporal server start-dev` then
# TEMPORAL_ADDRESS=localhost:7233. Temporal Cloud: address + API key.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=panga-deals

# --- ElevenLabs: voice rehearsal and voice-note transcription -------------
ELEVENLABS_API_KEY=
# Created by `npm run setup:voice`
ELEVENLABS_AGENT_ID=
# Any long random string. ElevenLabs sends it when it calls Panga's
# simulated-client endpoint; Panga rejects calls without it.
PANGA_SIM_SECRET=
# Your deployed https URL, used by `npm run setup:voice`
PANGA_PUBLIC_URL=
# Optional: a voice from your ElevenLabs library
ELEVENLABS_VOICE_ID=

# --- SerpApi: web research on unfamiliar requirements ------------------------
SERPAPI_API_KEY=

# --- Backboard: memory of your preferences and corrections -----------------
# Without it, memory is kept in Panga's own database.
BACKBOARD_API_KEY=

# --- Sentry: agent tracing and errors ----------------------------------------
SENTRY_DSN=
# Browser errors (must be set at build time on App Platform)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Limits on model calls (each call costs money) --------------------------
PANGA_RATE_LIMIT=60
PANGA_DAILY_LIMIT=2000
MASTRA_TELEMETRY_DISABLED=true
