# Local test configuration: every integration points at scripts/mock-services.mjs.
# Fake values only. Used by `npm run dev:mock`; your real keys go in .env.local.
DO_INFERENCE_BASE_URL=http://127.0.0.1:4010/v1
DO_MODEL_ACCESS_KEY=mock-local-key
PANGA_MODEL=gemma-4-31B-it
PANGA_EMBEDDING_MODEL=mock-embedding
PANGA_DATA_DIR=.data/mock
SERPAPI_BASE_URL=http://127.0.0.1:4010
SERPAPI_API_KEY=mock-serpapi-key
BACKBOARD_BASE_URL=http://127.0.0.1:4010/backboard
BACKBOARD_API_KEY=mock-backboard-key
ELEVENLABS_BASE_URL=http://127.0.0.1:4010/elevenlabs
ELEVENLABS_API_KEY=mock-elevenlabs-key
ELEVENLABS_AGENT_ID=agent_mock
PANGA_SIM_SECRET=mock-sim-secret
SPACES_ENDPOINT=http://127.0.0.1:4010/spaces
SPACES_KEY=mock-spaces-key
SPACES_SECRET=mock-spaces-secret
SPACES_BUCKET=panga-mock
MASTRA_TELEMETRY_DISABLED=true
